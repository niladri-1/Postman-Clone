{
  "name": "postmaster",
  "productName": "Postmaster",
  "version": "3.4.1",
  "description": "Postmaster — a lightweight, high-performance desktop API development client",
  "author": "Postmaster",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/electron-main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env PM_DEV=1 electron .",
    "dev": "npm run build:electron && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "icons": "node scripts/gen-icon.mjs",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.8.9",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "build": {
    "appId": "dev.postmaster.app",
    "productName": "Postmaster",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "Postmaster-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
